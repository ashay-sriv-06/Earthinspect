# Optional: enables the LLM copilot mode (server-side only; never sent to the browser).
# Without it, "Guided analysis" runs the same tools deterministically.
ANTHROPIC_API_KEY=
# Model id for the copilot. Defaults to claude-opus-5-5 when unset.
ANTHROPIC_MODEL=claude-opus-5-5
# Where SQLite and immutable artifacts live. Use a persistent volume in deployment.
EARTHINSPECT_DATA_DIR=./backend/var
# Built frontend served by FastAPI.
EARTHINSPECT_FRONTEND_DIST=./frontend/dist
